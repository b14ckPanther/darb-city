        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عشر تطبيقات. قوالب كلها شبه بعض. بحث بدّه الكلمة بالزبط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten apps. Look-alike templates. Search that needs the exact word."
