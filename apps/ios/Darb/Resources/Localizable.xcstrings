    "web.landing.platform.layers.1.body": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תפריט, הזמנות וחוויה שעוצבו מאפס. אף פעם לא תבנית."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منيو وحجوزات وتجربة معمولين من الصفر. ولا مرة قالب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu, bookings and an experience designed from zero. Never a template."
          }
        }
      }
    },
    "web.landing.platform.layers.1.title": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציה רק בשבילכם"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق إلك وبس"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app made only for you"
          }
        }
      }
    },
    "web.landing.platform.layers.2.body": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותבים כמו שמדברים, בכל שפה, גם מעורבב."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب متل ما بتحكي، بأي لغة، وحتى مخلوطة."
