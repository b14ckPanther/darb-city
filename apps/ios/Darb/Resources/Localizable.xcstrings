    "web.near.ask": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתפו מיקום פעם אחת ודרב יראה לכם את העסקים הכי קרובים. אנחנו לא שומרים אותו."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك موقعك مرة وحدة ودرب بفرجيك أقرب المصالح إلك. ما منحفظه عنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your location once and Darb shows the businesses closest to you. We never save it."
          }
        }
      }
    },
