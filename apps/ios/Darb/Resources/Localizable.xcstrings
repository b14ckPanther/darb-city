        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type it like you'd say it, in any language, even mixed."
          }
        }
      }
    },
    "web.landing.platform.layers.2.title": {
      "extractionState": "manual",
      "localizations": {
