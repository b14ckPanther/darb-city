    "web.landing.platform.without.body": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עשר אפליקציות. תבניות גנריות. חיפוש שדורש את המילה המדויקת."
          }
