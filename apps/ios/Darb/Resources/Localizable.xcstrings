    "web.contact.form.contact": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טלפון או אימייל"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلفون أو إيميل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone or email"
          }
        }
      }
    },
    "web.contact.form.contactHint": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי שנוכל לחזור אליכם."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عشان نقدر نرجعلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So we can get back to you."
          }
        }
      }
    },
    "web.contact.form.errors.contact": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבו מספר טלפון או כתובת אימייל."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب رقم تلفون أو إيميل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please write a phone number or an email address."
          }
        }
      }
    },
    "web.contact.form.errors.failed": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לשלוח את ההודעה. ההודעה שלכם עדיין כאן, נסו שוב."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما قدرنا نبعث رسالتك. رسالتك لسا هون، جرّب كمان مرة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't send your message. It's still here, please try again."
          }
        }
      }
    },
    "web.contact.form.errors.messageLong": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההודעה ארוכה מדי. קצרו אותה קצת."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرسالة طويلة كثير. قصّرها شوي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That message is too long. Please shorten it a little."
          }
        }
      }
    },
    "web.contact.form.errors.messageShort": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבו עוד קצת, לפחות 10 תווים."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب كمان شوي، 10 أحرف على الأقل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please write a little more, at least 10 characters."
          }
        }
      }
    },
    "web.contact.form.errors.name": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבו את השם שלכם, לפחות 2 אותיות."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب اسمك، حرفين على الأقل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please write your name, at least 2 letters."
          }
        }
      }
    },
    "web.contact.form.errors.tooMany": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלחתם כבר כמה הודעות. נסו שוב בעוד כמה דקות."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعثت كم رسالة. جرّب كمان كم دقيقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've sent a few messages already. Please try again in a few minutes."
          }
        }
