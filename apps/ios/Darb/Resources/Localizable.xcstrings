    "לא הצלחנו לבדוק את ההרשאות": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לבדוק את ההרשאות"
          }
