    "עוד אין הטבות פעילות. כשעסק יצטרף, ההטבה שלו תופיע כאן.": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוד אין הטבות פעילות. כשעסק יצטרף, ההטבה שלו תופיע כאן."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لسا ما في عروض شغالة. لما تنضم مصلحة، عرضها بيطلع هون."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No offers are running yet. When a business joins, its offer shows here."
          }
        }
      }
    },
