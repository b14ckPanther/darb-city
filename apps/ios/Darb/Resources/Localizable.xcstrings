    "web.landing.platform.layers.4.body": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לקוחות מגיעים אליכם, לא לפרסומת של המתחרה."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزباين بوصلوا لعندك، مش لإعلان المنافس."
