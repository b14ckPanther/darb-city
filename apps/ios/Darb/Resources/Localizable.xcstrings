    "היי, ראיתי אתכם בדרב. אתם פתוחים עכשיו?": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היי, ראיתי אתכם בדרב. אתם פתוחים עכשיו?"
          }
        },
        "ar": {
