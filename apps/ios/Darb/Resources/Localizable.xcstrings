    "web.landing.platform.with.body": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דרך אחת. אפליקציה שהיא שלכם. חיפוש שמבין אתכם."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
