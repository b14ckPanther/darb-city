    "web.contact.lead": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרו לנו על העסק שלכם, או שאלו כל דבר. אדם אמיתי קורא כל הודעה וחוזר אליכם."
          }
