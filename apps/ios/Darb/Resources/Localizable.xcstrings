        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to try again"
          }
        }
      }
    },
    "בארנק. החותמות מתעדכנות שם לבד.": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בארנק. החותמות מתעדכנות שם לבד."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالمحفظة. الأختام بتتحدّث هناك لحالها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Wallet. Stamps update there by themselves."
          }
        }
      }
    },
    "חותמות והטבות אצל העסקים השותפים, ב‑Apple Wallet": {
