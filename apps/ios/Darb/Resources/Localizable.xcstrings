    "web.landing.story.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למה דרב"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليش درب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why Darb"
          }
        }
      }
    },
    "web.landing.story.paragraphs.0": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דרב נולד מאהבה לבנות דברים שאנשים נהנים להשתמש בהם, מהרגע שבו מסך מרגיש חי ביד."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "درب طلع من حب إنّا نعمل أشيا الناس بتنبسط وهي تستعملها، من اللحظة اللي بتحس فيها إنّه الشاشة صارت عايشة بإيدك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darb was born from a love of building things people enjoy using, the moment a screen feels alive in your hand."
          }
        }
      }
    },
    "web.landing.story.paragraphs.1": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ומתסכול פשוט: למצוא מקום לא אמור לדרוש עשר אפליקציות ואת מילות החיפוש המדויקות. אז בנינו מקום אחד שמבין אותך כמו שאתה באמת מדבר, בכל שפה, גם חצי-חצי."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وطلع من قهر بسيط: لتلاقي محل، مش لازم تفتح عشر تطبيقات وتدوّر عالكلمة الصح. فعملنا مكان واحد بفهم عليك متل ما بتحكي، بأي لغة، وحتى نص بنص."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And from a simple frustration: finding a place shouldn't take ten apps and the exact right keywords. So we built one place that understands you the way you actually talk, in any language, even half and half."
          }
        }
      }
    },
    "web.landing.story.paragraphs.2": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רצינו יותר ממדריך. כל עסק ראוי לחוויה שנבנתה בשבילו, לא לתבנית שהוא חולק עם חמישים אחרים. כשקרמל עלו לאוויר, האפליקציה שלהם לא נראתה כמו של אף אחד אחר. זה הסטנדרט שלנו."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وبدنا أكثر من دليل. كل مصلحة بتستاهل تجربة معمولة إلها، مش قالب بتتقاسمه مع خمسين غيرها. لما كراميل نزلت لايف، تطبيقها ما كان يشبه حدا. هاد المستوى تبعنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We wanted more than a directory. Every business deserves an experience made for it, not a template it shares with fifty others. When Caramel went live, its app looked like no one else's. That's our standard."
          }
        }
      }
    },
    "web.landing.story.paragraphs.3": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל סוג של עסק. כל עיר וכל כפר. דרך אחת: דרב."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل أنواع المصالح. كل بلد وكل قرية. درب واحد: درب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every kind of business. Every town and village. One path: Darb."
          }
        }
      }
    },
    "web.landing.story.role": {
      "extractionState": "manual",
      "localizations": {
