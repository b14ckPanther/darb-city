    "%lld סוגים, %lld מקומות. בוחרים תחום, ואז סוג.": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld סוגים, %lld מקומות. בוחרים תחום, ואז סוג."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld نوع، %2$lld محل. اختار مجال، وبعدين نوع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kinds, %2$lld places. Pick an area, then a kind."
          }
        }
      }
    },
    "%lld עסקים אמיתיים ב %lld ישובים, ממקורות ציבוריים פתוחים. אין כאן עסק מומצא.": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld עסקים אמיתיים ב %lld ישובים, ממקורות ציבוריים פתוחים. אין כאן עסק מומצא."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld مصلحة حقيقية بـ %2$lld بلد، من مصادر عامة مفتوحة. ما في هون ولا مصلحة مخترعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld real businesses in %2$lld towns, from open public sources. No business here is made up."
          }
        }
      }
    },
