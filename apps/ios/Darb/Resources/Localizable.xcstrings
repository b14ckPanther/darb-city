    },
    "web.landing.platform.layers.3.body": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאתיים סוגי עסקים בערים ובכפרים, על מפה חיה אחת."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكثر من ميتين نوع مصلحة بالبلاد والقرى، على خريطة لايف وحدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two hundred kinds of businesses across towns and villages, on one live map."
          }
        }
      }
    },
    "web.landing.platform.layers.3.title": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל סוג, כל אזור"
          }
